{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],

  "labels": [
    "Renovate"
  ],

  "dependencyDashboard": true,
  "timezone": "America/New_York",

  "automerge": false,
  "rebaseWhen": "conflicted",

  "minimumReleaseAge": "7 days",
  "rangeStrategy": "bump",

  "patch": {
    "enabled": true
  },

  "ignorePaths": [
    "archive/**",
    "**/global.json"
  ],

  "nuget": {
    "ignorePaths": [
      "archive/**",
      "**/global.json"
    ],
  },

  "packageRules": [
    {
      "groupName": "dotnet-sdk",
      "matchPackageNames": [
        "dotnet-sdk",
      ],
    },
    {
      "groupName": "Exanite",
      "matchPackageNames": [
        "Exanite**",
      ],
    },
    {
      "groupName": "Exanite.Silk2.NET",
      "matchPackageNames": [
        "Exanite.Silk2.NET**",
      ],
    },
    {
      "groupName": "Exanite.Silk3.NET",
      "matchPackageNames": [
        "Exanite.Silk3.NET**",
      ],
    },
  ]
}
